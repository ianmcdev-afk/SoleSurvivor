<Window x:Class="SoleSurvivor.App.RulesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="How to play Sole Survivor"
        Width="680" Height="760"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{StaticResource BgBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI" FontSize="13.5">
    <Window.Resources>
        <Style x:Key="H" TargetType="TextBlock" BasedOn="{StaticResource SectionTitle}">
            <Setter Property="Margin" Value="0,16,0,4"/>
        </Style>
        <Style x:Key="P" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,2,0,4"/>
            <Setter Property="LineHeight" Value="20"/>
        </Style>
    </Window.Resources>
    <DockPanel>
        <Button DockPanel.Dock="Bottom" Content="Back to the village" Style="{StaticResource ActionButton}"
                HorizontalContentAlignment="Center" Margin="20,10,20,16" Click="Close_Click" IsDefault="True" IsCancel="True"/>
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24,16,24,8">
            <StackPanel>
                <TextBlock Text="{}{TITLE}" FontFamily="Georgia" FontSize="26" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
                <TextBlock Style="{StaticResource P}" FontFamily="Georgia" FontStyle="Italic" Foreground="{StaticResource DimBrush}"
                           Text="{}{intro}"/>

                <TextBlock Style="{StaticResource H}" Text="Reading the screen"/>
                <TextBlock Style="{StaticResource P}" Text="The bar across the top shows where you are in the round: YOUR TURN › {DECK} › {SHE} MOVES › {SHE} ATTACKS. The glowing step is happening now, and the hint beside it tells you what to do."/>
                <TextBlock Style="{StaticResource P}" Text="On the board, places you can go right now are ringed in gold and joined to you by moving dotted paths. ✦ badges show how many things are still hidden at a location. Small figures are {victims} waiting to be rescued."/>
                <TextBlock Style="{StaticResource P}" Text="When {killer} takes {her} turn, {her} card flips up in the middle of the board and stays there until you click, so you can read it. Tick 'Fast animations' in the header to speed everything up."/>

                <TextBlock Style="{StaticResource H}" Text="How you win"/>
                <TextBlock Style="{StaticResource P}" Text="Wound {killer} until {her} health reaches 0. You lose if your own health reaches 0. Along the way, lead {victims} to the {sanctuary}. Every {victim} {she} kills raises {her} Bloodlust, so saving people keeps {her} weaker."/>

                <TextBlock Style="{StaticResource H}" Text="Your turn"/>
                <TextBlock Style="{StaticResource P}" Text="You gain Time at the start of each round. You can hold up to 8, and anything you don't spend carries over. Spend it on these actions, in any order and as often as you can afford:"/>
                <TextBlock Style="{StaticResource P}" Text="•  Walk (1): move to a connected location. Click a highlighted location on the board."/>
                <TextBlock Style="{StaticResource P}" Text="•  Escort (1): move and bring up to 2 {victims} from your location with you (3 with the {rope}). {Victims} who reach the {sanctuary} are saved, and each one gives you 1 Hope."/>
                <TextBlock Style="{StaticResource P}" Text="•  Search (2): roll your Horror dice, plus 1 for a light. Each success finds one item hidden at your location, up to 2."/>
                <TextBlock Style="{StaticResource P}" Text="•  Fight (2): only when {she}'s in your location. Roll your Horror dice plus 1 per weapon. Each success is a wound."/>
                <TextBlock Style="{StaticResource P}" Text="•  Rest (2): heal 1, but not while {she}'s beside you."/>
                <TextBlock Style="{StaticResource P}" Text="Starting cards: before round 1 you pick 3 of 5 free starter cards (Quick Step, Guide, Shove, Glance Around, Catch Your Breath). They cost nothing, wait in your hand, and are gone once played or discarded."/>
                <TextBlock Style="{StaticResource P}" Text="Some market cards are FREE (Scramble, Peek, Holler): take them without spending Time. They're small on their own, but every card in your hand is something to trade in for a partial die."/>
                <TextBlock Style="{StaticResource P}" Text="Five action cards are offered in the market each round, in the strip under the board. Buy them with Time and they go into your hand, beside the market (4 cards at most). Playing a card from your hand is free, this turn or a later one. Cards you don't buy are swept away at the end of the round. Any card in your hand can also be discarded for +1 Time, up to the 8 Time limit."/>

                <TextBlock Style="{StaticResource H}" Text="The Horror track: dice, Hope and Dread"/>
                <TextBlock Style="{StaticResource P}" Text="The Horror track decides how many dice you roll. Uneasy (Dread 1-2): 3 Horror dice. Afraid (Dread 3-5): 2. Terror (Dread 6+) and the finale: 1. Fight and Search start from your Horror dice; weapons, light and cards add to them. You always roll at least 1 die. Spend 1 Hope to steel yourself and add a die to your next roll. Dread rises when {her} Bloodlust reaches a ☠ level, and some {deck}s raise it too. At Dread 8 the {finale} begins."/>
                <TextBlock Style="{StaticResource P}" Text="Horror dice have icons, not just numbers. ★ (5 or 6) is a success. ▮▮ (3 or 4, the two-cards icon) is a partial: you may discard 2 cards from your hand to turn it into a success, once per die. 1 and 2 are blank. After a roll with partials, a panel asks which cards to trade in, or you can keep the roll as it is. If nothing succeeds, the roll fails."/>

                <TextBlock Style="{StaticResource H}" Text="{}{Killer}'s turn"/>
                <TextBlock Style="{StaticResource P}" Text="When you end your turn, a {deck} is drawn. A card says who {she} goes for (the nearest {victims}, or you), how {she} gets there (moves, or appears somewhere), and whether {she} attacks. It never says how far or how hard: the killer board does."/>
                <TextBlock Style="{StaticResource P}" Text="The killer board's Bloodlust track sets how many spaces {she} moves (➤) and how much damage an attack does (⚔). An attack hits everyone in {her} space: that many {victims} die, and you lose that much health. There are no dice; holding your breath takes 1 off."/>
                <TextBlock Style="{StaticResource P}" Text="Every {victim} {she} kills moves Bloodlust up one level, so {she} gets faster and hits harder. Some levels trigger once when reached: ☠ raises your Dread by 1, ♥ (Frenzy) heals {her} 2. Once the track is full, every further kill heals {her} 1. A barred door keeps {her} out of your location for one {round}."/>

                <TextBlock Style="{StaticResource H}" Text="Events"/>
                <TextBlock Style="{StaticResource P}" Text="An event card is revealed at the start of the night, and another whenever a {deck} shows the ▣ EVENT icon. Some help you (green ✚), some hurt (red ✖), some cut both ways (gold ◆). One-time events happen and are gone. Ongoing events stay in play, listed under the killer board, until their discard condition: after 3 rounds, when a trap springs, when you wound {her}, and so on. A new event never cancels an old one. If an event can't take effect (say, there's no {victim} left to pick), it is simply ignored."/>
                <TextBlock Style="{StaticResource P}" Text="Special {victims}: some events turn a {victim} into a special one, shown in blue or orange on the board. They follow you and can be saved or killed like anyone else, but their card says what happens when they are. The special {victim} always comes along when you escort from their location."/>

                <TextBlock Style="{StaticResource H}" Text="The {finale} (finale)"/>
                <TextBlock Style="{StaticResource P}" Text="The {finale} comes when the {deck}s run out or Dread reaches 8. Every {victim} still out there is lost. {She} gains 3 health and from then on hunts only you, moving 1 more and attacking for 1 more than {her} Bloodlust says, every {round}. Finish it."/>

                <TextBlock Style="{StaticResource H}" Text="Tips"/>
                <TextBlock Style="{StaticResource P}" Text="•  Early on, rescues pay twice: the {victim} can't raise {her} Bloodlust, and you get Hope."/>
                <TextBlock Style="{StaticResource P}" Text="•  Pick up a weapon or two before you go looking for a fight. Places marked ✦ still hide something."/>
                <TextBlock Style="{StaticResource P}" Text="•  The {flare} and the {salt} also work from an adjacent location."/>
                <TextBlock Style="{StaticResource P}" Text="•  Press E to end your turn, Esc for the menu, M to mute the sound."/>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
